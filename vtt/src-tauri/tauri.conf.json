{
  "productName": "DM Toolkit VTT",
  "version": "0.1.0",
  "identifier": "com.dmtoolkit.vtt",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "controller",
        "title": "DM Toolkit VTT — Controller",
        "url": "/",
        "width": 900,
        "height": 640,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPLOCALDATA/**", "$HOME/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdDRUU4NzkzRDJCMEMyMUYKUldRZndyRFNrNGZ1Zk1VUjlvNlAxeHJybEROeUZ2T2liMGxzNSt1OUhTbEtRaGRoSWlZVGY1ZDMK",
      "endpoints": [
        "https://github.com/sven-johnson/DM-Toolkit/releases/latest/download/latest.json"
      ]
    }
  }
}
